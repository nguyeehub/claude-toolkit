{
  "name": "claude-toolkit",
  "owner": {
    "name": "nguyeehub"
  },
  "description": "My skills, plugins and MCP servers for coding agents.",
  "plugins": [
    {
      "name": "my-skills",
      "description": "My own skills from the top-level skills/ folder.",
      "source": "./",
      "category": "core",
      "strict": false
    },
    {
      "name": "mattpocock-skills",
      "description": "Matt Pocock's engineering skills: grilling, TDD, code review, domain modelling and more.",
      "source": {
        "source": "url",
        "url": "https://github.com/mattpocock/skills.git"
      },
      "homepage": "https://github.com/mattpocock/skills",
      "category": "core"
    },
    {
      "name": "emil-design-eng",
      "description": "Emil Kowalski's design engineering skills: animation, UI polish, prototyping, Apple-style design.",
      "source": {
        "source": "url",
        "url": "https://github.com/emilkowalski/skills.git"
      },
      "homepage": "https://github.com/emilkowalski/skills",
      "strict": false,
      "category": "core"
    },
    {
      "name": "vercel",
      "description": "Vercel skills, hooks and MCP server.",
      "source": {
        "source": "url",
        "url": "https://github.com/vercel/vercel-plugin.git"
      },
      "homepage": "https://github.com/vercel/vercel-plugin",
      "category": "platform"
    },
    {
      "name": "neon",
      "description": "Neon Postgres skill and MCP server.",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/neondatabase/agent-skills.git",
        "path": "plugins/neon-postgres",
        "ref": "main"
      },
      "homepage": "https://github.com/neondatabase/agent-skills",
      "category": "platform"
    },
    {
      "name": "supabase",
      "description": "Supabase skills and MCP server.",
      "source": {
        "source": "url",
        "url": "https://github.com/supabase-community/supabase-plugin.git"
      },
      "homepage": "https://github.com/supabase-community/supabase-plugin",
      "category": "platform"
    },
    {
      "name": "linear",
      "description": "Linear MCP server.",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/anthropics/claude-plugins-official.git",
        "path": "external_plugins/linear",
        "ref": "main"
      },
      "category": "platform"
    },
    {
      "name": "github",
      "description": "GitHub MCP server. Needs GITHUB_PERSONAL_ACCESS_TOKEN in the environment.",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/anthropics/claude-plugins-official.git",
        "path": "external_plugins/github",
        "ref": "main"
      },
      "category": "platform"
    }
  ]
}
